<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<!-- 開關與基本設定 -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>RedStar Internal Settings</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.tnhdev.redstar</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enabled</string>
			<key>PostNotification</key>
			<string>com.tnhdev.redstar/ReloadPrefs</string>
		</dict>

		<!-- 週期設定 -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Screenshot cycle (minutes)</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>default</key>
			<string>5</string>
			<key>defaults</key>
			<string>com.tnhdev.redstar</string>
			<key>key</key>
			<string>intervalMinutes</string>
			<key>placeholder</key>
			<string>Recommend: 5</string>
			<key>isNumeric</key>
			<true/>
			<key>PostNotification</key>
			<string>com.tnhdev.redstar/ReloadPrefs</string>
		</dict>

		<!-- UUID 設定 -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Trace Viewer Data UUID</string>
			<key>footerText</key>
			<string>Enter App Data Container UUID</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSEditTextCell</string>
			<key>default</key>
			<string></string>
			<key>defaults</key>
			<string>com.tnhdev.fun.redstar</string>
			<key>key</key>
			<string>appUUID</string>
			<key>placeholder</key>
			<string>XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX</string>
			<key>PostNotification</key>
			<string>com.tnhdev.fun.redstar/ReloadPrefs</string>
		</dict>

		<!-- 手動測試與日誌區塊 -->
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Diagnose &amp; Test</string>
			<key>footerText</key>
			<string>Logs will be saved to /var/jb/RedStar/test_log.txt</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Run Manual Test</string>
			<key>action</key>
			<string>runTestAndLog</string>
		</dict>
	</array>
	<key>title</key>
	<string>RedStar</string>
</dict>
</plist>
