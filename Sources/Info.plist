<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App 執行檔名稱，$(EXECUTABLE_NAME) 會自動套用專案名稱 -->
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<!-- App 的唯一識別碼 (Bundle ID) -->
	<key>CFBundleIdentifier</key>
	<string>com.tnhdev.fun.TraceViewer</string>

	<!-- App 顯示的名稱 -->
	<key>CFBundleName</key>
	<string>Trace Viewer</string>

	<!-- 類型，APPL 代表這是一個應用程式 (Application) -->
	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- App 顯示給使用者看的版本號 (例如 1.0.0) -->
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>

	<!-- 內部 Build 號 (例如 1, 2, 3...) -->
	<key>CFBundleVersion</key>
	<string>1</string>

	<!-- 啟用 iOS 預設的空白啟動畫面 (SwiftUI 簡化設定) -->
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
